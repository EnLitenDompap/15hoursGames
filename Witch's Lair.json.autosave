me":"Vampire"},{"objectName":"Goblin"},{"objectName":"Dragon"},{"objectName":"Prince"},{"objectName":"cat"}]},{"folderName":"Dialogue","children":[{"objectName":"dialogue"},{"objectName":"textBox"}]},{"folderName":"The book","children":[{"objectName":"flipRight"},{"objectName":"bookButton"},{"objectName":"flipLeft"},{"objectName":"book"},{"objectName":"closeBookButton"}]},{"folderName":"Interactables","children":[{"objectName":"trashButton"},{"objectName":"mugwortPlant"},{"objectName":"trashBack"},{"objectName":"placeholder"},{"objectName":"voice"},{"objectName":"nail"},{"objectName":"thistle"},{"objectName":"honey"},{"objectName":"eyeball"},{"objectName":"ink"},{"objectName":"sage"},{"objectName":"stardust"},{"objectName":"teeth"},{"objectName":"turmeric"},{"objectName":"snakeSkin"},{"objectName":"mugwortLeaf"},{"objectName":"Orchid"},{"objectName":"bottleEmpty"}]},{"folderName":"Programmer help","children":[{"objectName":"boundries"},{"objectName":"cameraBorder"}]},{"folderName":"UI","children":[{"objectName":"bookOpenButton"},{"objectName":"reset"},{"objectName":"arrow"}]},{"folderName":"Furniture (does things)","children":[{"objectName":"door"},{"objectName":"bell"}]},{"folderName":"Furniture (static)","children":[{"objectName":"doorBackground"},{"objectName":"OOH"},{"objectName":"cabinetShelf"},{"objectName":"cabinetBack"},{"objectName":"mat"},{"objectName":"tableLeft"},{"objectName":"tableRight"},{"objectName":"cauldron"},{"objectName":"potionApparatus"},{"objectName":"potionApparatusShelf"},{"objectName":"wallpaper2"},{"objectName":"wallpaper"},{"objectName":"floor"}]}]},"events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"Tests (These should be deleted)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextPressed"},"parameters":["","\"z\""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["tutorialEnd","=","1"]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"Just comments","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Subevent like to hide under it's event, and you gotta click this small arrow next to the main event to see it."},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"SO! Writing here in case it helps you too, because it sure was hard to find the answer to!\nThere is something called object groups, which is a list of objects you can make. Everywhere you can put an onject in the code, you can put in an \"object group\" to make it affect ALL things in that list.\nIf you give the object group an object variable, that variable will be give to each object on that list AND each object can have a different value on that variable.\n\nIt's kinda wonky, but look at the code in setup and reset position to see it in action. Make a \"repeat for each instance of [objectGroup]\", pick your object group (It's at the bottom of the object list), choose \"change variable\".\nIn the \"set to ingredients.X()\" part, ingredients is the object group containing every ingredient object, but because we are \"repeating for each instance\", it is using the object in the object group that is currently being affected by the code.\n\nAka, this code sets the variable startx to current X position, and will do so for each and every object in the object group, individually."}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"Setup (That has to be in the beginning)","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SceneJustBegins"},"parameters":[""]}],"actions":[{"type":{"value":"Hide"},"parameters":["boundries"]},{"type":{"value":"DialogueTree::LoadDialogueFromJsonFile"},"parameters":["","Main Dialogue"]},{"type":{"value":"SetNumberVariable"},"parameters":["tutorialStart","=","0"]},{"type":{"value":"ResetTimer"},"parameters":["","\"Knock\""]},{"type":{"value":"PlayMusic"},"parameters":["","Soundtrack_15hours_22-01-2026.mp3","yes","Variable(musicVolume)","1"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Saves the position into each ingredients object variable, that are in the object group.\nA bit wonky, but each ingredient will have a number ID that follows the order in the object group. Remember that it starts at 0. Used to keep tabs on what's in the cauldron/potion."},{"type":"BuiltinCommonInstructions::ForEach","object":"ingredients","conditions":[],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["ingredients","startx","=","ingredients.X()"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["ingredients","starty","=","ingredients.Y()"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["ingredients","ID","=","indexCount"]},{"type":{"value":"SetNumberVariable"},"parameters":["indexCount","+","1"]}]}],"variables":[{"name":"indexCount","type":"number","value":0.0}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Reset position of ingredients","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"When the \"reset button \" is clicked, put everything back in its original position after 0.5 seconds. The wait time is so that it looks like it is reseting to the player's eye, especially when replacing and empty bottle with another empty bottle. Also resets the cauldron variables, which need to be cleaned up a bit 😅"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"IsCursorOnObject"},"parameters":["trashButton","","",""]},{"type":{"value":"MouseButtonFromTextPressed"},"parameters":["","\"Left\""]},{"type":{"value":"BooleanVariable"},"parameters":["mouseHasClicked","False",""]},{"type":{"value":"BooleanVariable"},"parameters":["popUp","False",""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::ForEach","object":"ingredients","conditions":[],"actions":[{"type":{"value":"Wait"},"parameters":["0.5"]},{"type":{"value":"ActivateBehavior"},"parameters":["ingredients","Physics2",""]},{"type":{"value":"SetX"},"parameters":["ingredients","=","ingredients.startx"]},{"type":{"value":"SetY"},"parameters":["ingredients","=","ingredients.starty"]},{"type":{"value":"SetAngle"},"parameters":["ingredients","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["cauldronCounter","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["ingredientsCounted","=","0"]},{"type":{"value":"SetBooleanVariable"},"parameters":["potionBrewed","False","0"]},{"type":{"value":"Delete"},"parameters":["potions",""]},{"type":{"value":"Wait"},"parameters":["0.5"]},{"type":{"value":"Create"},"parameters":["","bottleEmpty","65","285",""]},{"type":{"value":"ResizableCapability::ResizableBehavior::SetSize"},"parameters":["bottleEmpty","Resizable","163","154"]},{"type":{"value":"ChangePlan"},"parameters":["bottleEmpty","=","25"]},{"type":{"value":"ActivateBehavior"},"parameters":["potions","Physics2",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["mouseHasClicked","True",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["recipeMade","False",""]}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"UI elements","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"This code moves the camera back and forth between the two positions.\nThe \"trigger once\" part is not perfect, as if you go outside the object and back in while still holding the same click, it registers as 2 clicks. Wish it did like unity, seperate between click, holding, and release.\nSo I'm doing that with the boolean \"Mouse has clicked\""},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"MouseButtonFromTextPressed"},"parameters":["","\"Left\""]},{"type":{"value":"IsCursorOnObject"},"parameters":["arrow","","",""]},{"type":{"value":"BooleanVariable"},"parameters":["mouseHasClicked","False",""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["cameraPosition","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["cameraPosition","=","2"]},{"type":{"value":"SetCameraCenterX"},"parameters":["","=","-200","",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["replacementForElseIf","True",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["mouseHasClicked","True",""]},{"type":{"value":"SetAngle"},"parameters":["arrow","=","180"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["cameraPosition","=","2"]},{"type":{"value":"BooleanVariable"},"parameters":["replacementForElseIf","=",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["cameraPosition","=","1"]},{"type":{"value":"SetCameraCenterX"},"parameters":["","=","460","",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["mouseHasClicked","True",""]},{"type":{"value":"SetAngle"},"parameters":["arrow","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["replacementForElseIf","True",""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["replacementForElseIf","False","2"]}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"folded":true,"name":"Animation events","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"As far as I can tell, the engine lacks an event system? Will check later if there's an addon, but for now, there's this"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"1. Door opening\n2. Potion brewing"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["animationEvent","=","1"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["animationEvent","=","0"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["door","Animation","=","\"open\""]},{"type":{"value":"PlaySound"},"parameters":["","Art assets\\Sound effects\\Store Bell Sound Effect.mp3","","100","1"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["bell","Animation","=","\"Ringing\""]},{"type":{"value":"Wait"},"parameters":["1.5"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["door","Animation","=","\"closed\""]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["bell","Animation","=","\"Still\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["animationEvent","=","2"]}],"actions":[{"type":{"value":"Create"},"parameters":["","potionBrewing","87","248",""]},{"type":{"value":"ResizableCapability::ResizableBehavior::SetSize"},"parameters":["potionBrewing","Resizable","128","189"]},{"type":{"value":"ChangePlan"},"parameters":["potionBrewing","=","6"]}]}